.version 8.0
.target sm_70
.address_size 64
.visible .entry branches(.param .u64 output) {
    .reg .b32 %r<2>;
    .reg .b64 %rd;
    .reg .pred %p<2>;
    ld.param.u64 %rd, [output];
    mov.u32 %r0, %tid.x;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 bra zero;
    and.b32 %r1, %r0, 1;
    setp.eq.u32 %p1, %r1, 0;
    @!%p1 bra odd;
    mov.u32 %r1, 2;
    bra.uni store;
odd:
    mov.u32 %r1, 3;
    bra store;
zero:
    mov.u32 %r1, 1;
store:
    st.global.u32 [%rd], %r1;
    ret;
}
