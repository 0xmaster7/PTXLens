.version 8.0
.target sm_70
.address_size 64
.file 1 "source; // not a comment.cu"
.visible .entry unusual(
    .param .u64 pointer
) {
    .reg .b32 %r<160>; /* fake: st.global.u32 [%rd], %r; */
    .reg .b64 %rd;
    .reg .pred %p;
    // fake: add.u32 %r0, %r1, %r2; ret;
    ld.param.u64 %rd,
        [pointer]; mov.u32 %r0, 1; mov.u32 %r0, %r0;
    {
        ld.global.u32 %r1, [%rd + 4];
        ld.global.u32 %r2, [%rd+4];
        setp.ne.u32 %p, %r0, 0;
        @ ! %p mov.u32 %r0, %r1;
    }
    st.global.u32 [%rd], %r0; ret;
}
