.version 8.0
.target sm_70
.address_size 64
// Matrix-related scalar inner-product arithmetic, not a complete GEMM implementation.
.visible .entry dot4(.param .u64 a, .param .u64 b, .param .u64 out) {
    .reg .b64 %rd<3>;
    .reg .f32 %f<3>;
    ld.param.u64 %rd0, [a]; ld.param.u64 %rd1, [b]; ld.param.u64 %rd2, [out];
    mov.f32 %f2, 0f00000000;
    ld.global.f32 %f0, [%rd0]; ld.global.f32 %f1, [%rd1];
    fma.rn.f32 %f2, %f0, %f1, %f2;
    ld.global.f32 %f0, [%rd0+4]; ld.global.f32 %f1, [%rd1+4];
    fma.rn.f32 %f2, %f0, %f1, %f2;
    ld.global.f32 %f0, [%rd0+8]; ld.global.f32 %f1, [%rd1+8];
    fma.rn.f32 %f2, %f0, %f1, %f2;
    ld.global.f32 %f0, [%rd0+12]; ld.global.f32 %f1, [%rd1+12];
    fma.rn.f32 %f2, %f0, %f1, %f2;
    st.global.f32 [%rd2], %f2;
    ret;
}
